{
  "info": {
    "name": "Parcial3-Microservicios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "parcial3-microservicios-collection"
  },
  "item": [
    {
      "name": "Create - insert mascotas",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"name\": \"Azul\", \"age\": 2 }" },
        "url": { "raw": "http://localhost:8081/mascotas", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["mascotas"] }
      }
    },
    {
      "name": "Read - list mascotas",
      "request": { "method": "GET", "url": { "raw": "http://localhost:8082/mascotas", "protocol": "http", "host": ["localhost"], "port": "8082", "path": ["mascotas"] } }
    },
    {
      "name": "Update - update mascotas",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"name\": \"Lola\", \"age\": 4 }" },
        "url": { "raw": "http://localhost:8083/mascotas/:id", "protocol": "http", "host": ["localhost"], "port": "8083", "path": ["mascotas", ":id"] }
      }
    },
    {
      "name": "Delete - delete mascotas",
      "request": { "method": "DELETE", "url": { "raw": "http://localhost:8084/mascotas/:id", "protocol": "http", "host": ["localhost"], "port": "8084", "path": ["mascotas", ":id"] } }
    }
  ]
}